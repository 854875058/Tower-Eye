# 设置所有 .sh 文件使用 LF 换行符
*.sh text eol=lf

# 设置所有文本文件的默认行为
* text=auto

# 明确指定某些文件类型
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.db binary
*.pt binary
*.npy binary
